# Copy to .env.local. Never commit real values.

# Basemap provider: "maplibre" (default, keyless) or "mapbox" (not wired yet).
NEXT_PUBLIC_MAP_PROVIDER=maplibre

# Server-only. Required by api.weather.gov: app name + contact. Used by /api/weather (TODO).
NWS_USER_AGENT="TriggerPoint (you@example.com)"
